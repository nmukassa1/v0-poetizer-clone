# Copy to .env.local — Next.js and Prisma CLI both read this file
# Requires Node.js >= 20.19 (see .nvmrc)

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon Auth — enable in Neon Console → Branch → Auth → Configuration
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"

# Optional
# NEXT_PUBLIC_ANNOUNCEMENT=""
# NEXT_PUBLIC_ANNOUNCEMENT_LINK="/about"
# CONTACT_WEBHOOK_URL=""
