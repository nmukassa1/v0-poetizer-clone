generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// App models (profiles, pieces) are added in Step 3.
// Neon Auth manages its own auth tables when enabled in the Neon console.

/// Temporary model so Prisma can generate a client in Step 1.
/// Dropped when app models are added in Step 3.
model ConnectionCheck {
  id String @id @default(cuid())

  @@map("_connection_check")
}
